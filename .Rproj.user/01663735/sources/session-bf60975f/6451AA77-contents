# ─────────────────────────────────────────────────────────────────────────────
# Forest plot: FST Interaction | Shot Type Interaction | Age Group Interaction
# Requires: ggplot2, scales
# ─────────────────────────────────────────────────────────────────────────────

library(ggplot2)
library(scales)

# ── 1. Load data ──────────────────────────────────────────────────────────────
fst  <- read.csv("interaction_fst.csv",  check.names = FALSE, fileEncoding = "UTF-8-BOM")
shot <- read.csv("interaction_shot.csv", check.names = FALSE, fileEncoding = "UTF-8-BOM")
age  <- read.csv("interaction_age.csv",  check.names = FALSE, fileEncoding = "UTF-8-BOM")

# Rename 'models' to 'model' for script compatibility
colnames(fst)[1]  <- "model"
colnames(shot)[1] <- "model"
colnames(age)[1]  <- "model"

# ── 2. Strip asterisks ────────────────────────────────────────────────────────
strip_asterisk <- function(df) {
  df$model <- trimws(gsub("\\*", "", df$model))
  df
}
fst  <- strip_asterisk(fst)
shot <- strip_asterisk(shot)
age  <- strip_asterisk(age)

# ── 3. Master row order (top → bottom) ────────────────────────────────────────
master_levels <- c(
  # Base Models
  "BiomedCLIP", "Citrus-V", "Claude", "Llama", "Monet", "SkinGPT",
  # Objective Quality Metrics
  "Lighting -", "Camerawork -", "Artifacts -",
  # Subjective Quality Metrics
  "Morphology", "Size", "Demarcation", "Color", "Texture", "Distribution",
  # Fitzpatrick Skin Type (FST) & Interactions
  "Fitzpatrick III & IV", "Fitzpatrick V & VI",
  "BiomedCLIP x III & IV", "BiomedCLIP x V & VI",
  "Citrus-V x III & IV", "Citrus-V x V & VI",
  "Claude x III & IV", "Claude x V & VI",
  "Llama x III & IV", "Llama x V & VI",
  "Monet x III & IV", "Monet x V & VI",
  "SkinGPT x III & IV", "SkinGPT x V & VI",
  # Shot Type & Interactions
  "At a Distance", "Close Up",
  "BiomedCLIP x Distance", "BiomedCLIP x Close Up",
  "Citrus-V x Distance", "Citrus-V x Close Up",
  "Claude x Distance", "Claude x Close Up",
  "Llama x Distance", "Llama x Close Up",
  "Monet x Distance", "Monet x Close Up",
  "SkinGPT x Distance", "SkinGPT x Close Up",
  # Age Group & Interactions
  "40 to 59 Years", "60 to 79 Years",
  "BiomedCLIP x 40 to 59", "BiomedCLIP x 60 to 79",
  "Citrus-V x 40 to 59", "Citrus-V x 60 to 79",
  "Claude x 40 to 59", "Claude x 60 to 79",
  "Llama x 40 to 59", "Llama x 60 to 79",
  "Monet x 40 to 59", "Monet x 60 to 79",
  "SkinGPT x 40 to 59", "SkinGPT x 60 to 79"
)

# ── 4. Pad every dataset to the full 57-row set (NA for absent rows) ──────────
pad_to_master <- function(df, master) {
  df <- df[, c("model", "OR", "lower", "upper")]
  missing <- setdiff(master, df$model)
  if (length(missing) > 0) {
    df <- rbind(df, data.frame(model = missing, OR = NA_real_,
                               lower = NA_real_, upper = NA_real_,
                               stringsAsFactors = FALSE))
  }
  df$model <- factor(df$model, levels = rev(master))
  df
}

fst_p  <- pad_to_master(fst,  master_levels)
shot_p <- pad_to_master(shot, master_levels)
age_p  <- pad_to_master(age,  master_levels)

# ── 5. Shared x limits ────────────────────────────────────────────────────────
x_lo <- min(c(fst_p$lower, shot_p$lower, age_p$lower), na.rm = TRUE) * 0.5
x_hi <- max(c(fst_p$upper, shot_p$upper, age_p$upper), na.rm = TRUE) * 2.5

# ── 6. Long data with panel factor ────────────────────────────────────────────
panel_levels <- c("Fitzpatrick Skin Type (FST)", "Shot Type", "Age Group")

all_data <- rbind(
  transform(fst_p,  panel = panel_levels[1]),
  transform(shot_p, panel = panel_levels[2]),
  transform(age_p,  panel = panel_levels[3])
)
all_data$panel <- factor(all_data$panel, levels = panel_levels)

# ── 7. Row highlight positions ────────────────────────────────────────────────
n_rows <- length(master_levels)
hl_pos <- seq(2, n_rows, by = 2)

# Left-of-labels extension, restricted to the FIRST facet only
left_ext <- data.frame(ymin  = hl_pos - 0.5,
                       ymax  = hl_pos + 0.5,
                       panel = factor(panel_levels[1], levels = panel_levels))

# ── 8. Plot ───────────────────────────────────────────────────────────────────
p <- ggplot(all_data, aes(x = OR, y = model)) +
  
  # Background Shading
  annotate("rect",
           ymin = hl_pos - 0.5, ymax = hl_pos + 0.5,
           xmin = x_lo, xmax = x_hi,
           fill = "grey91") +
  
  geom_rect(data = left_ext,
            aes(ymin = ymin, ymax = ymax),
            xmin = x_lo * 1e-6, xmax = x_lo,
            fill = "grey91", inherit.aes = FALSE) +
  
  # Manual Y-axis line drawn on ALL panels at the left border (x_lo)
  geom_vline(xintercept = x_lo, colour = "grey55", linewidth = 0.5) +
  
  # Lighter vertical dotted lines for the other x-axis increments
  geom_vline(xintercept = c(0.03, 0.1, 0.3, 3), linetype = "dotted",
             colour = "grey75", linewidth = 0.4) +
  
  # Main reference line at OR = 1
  geom_vline(xintercept = 1, linetype = "dashed",
             colour = "grey55", linewidth = 0.5) +
  
  # Data geometries
  geom_errorbarh(aes(xmin = lower, xmax = upper),
                 height = 0.30, linewidth = 0.65,
                 colour = "black", na.rm = TRUE) +
  
  geom_point(size = 3.5, colour = "black", shape = 15, na.rm = TRUE) +
  
  # Position titles underneath the panels
  facet_grid(. ~ panel, switch = "x") +
  
  scale_x_log10(
    limits = c(x_lo, x_hi),
    breaks = c(0.03, 0.1, 0.3, 1, 3), 
    labels = label_number(drop0trailing = TRUE),
    expand = expansion(0),
    oob    = scales::oob_keep
  ) +
  scale_y_discrete(drop = FALSE) +
  coord_cartesian(clip = "off") +
  
  labs(
    title = "Forest Plots of Odds Ratios by Model Type and Image Quality Interactions",
    x     = "Odds Ratio (log scale)",
    y     = NULL
  ) +
  
  theme_minimal(base_size = 10) +
  theme(
    plot.title         = element_text(face = "bold", hjust = 0.5, size = 13,
                                      margin = margin(b = 12)),
    
    strip.text         = element_text(face = "bold", size = 10.5, hjust = 0.5,
                                      margin = margin(t = 10, b = 5)),
    strip.background   = element_blank(),
    strip.placement    = "outside", 
    
    axis.text.y        = element_text(size = 8.5, colour = "grey40", hjust = 1),
    axis.text.x        = element_text(colour = "grey40"),
    axis.title.x       = element_text(size = 9, colour = "grey40",
                                      margin = margin(t = 8)),
    
    # Axis line settings
    axis.line.x        = element_line(colour = "grey55", linewidth = 0.5),
    axis.line.y        = element_blank(), 
    
    panel.grid.major.x = element_blank(),
    panel.grid.major.y = element_blank(),
    panel.grid.minor   = element_blank(),
    
    panel.background   = element_blank(),
    panel.border       = element_blank(),
    panel.spacing.x    = unit(1.5, "lines"), 
    legend.position    = "none",
    plot.margin        = margin(12, 12, 12, 12)
  )

# ── 9. Save ───────────────────────────────────────────────────────────────────
ggsave(
  filename = "forest_plot.png",
  plot     = p,
  width    = 11,  
  height   = 24, # Increased to accommodate 57 rows perfectly without crowding
  dpi      = 300,
  bg       = "white"
)

message("Saved: forest_plot.png")